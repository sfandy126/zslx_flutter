{
    // 使用 IntelliSense 了解相关属性。 
    // 悬停以查看现有属性的描述。
    // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
    // Android 必须带 --flavor（渠道见 flavorizr.yaml）；iOS 固定 AppStore，不带 --flavor
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Android (companywebsite)",
            "request": "launch",
            "type": "dart",
            "args": ["--flavor", "companywebsite"]
        },
        {
            "name": "Android (companywebsite, profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "args": ["--flavor", "companywebsite"]
        },
        {
            "name": "Android (companywebsite, release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "args": ["--flavor", "companywebsite"]
        },
        {
            "name": "iOS (AppStore)",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "iOS (AppStore, profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "iOS (AppStore, release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}
